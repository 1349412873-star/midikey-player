<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MidiKeyPlayer"
        x:Class="MidiKeyPlayer.KeymapWindow"
        Title="键位设置"
        Width="660" Height="620"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}">

  <Window.Styles>
    <!-- 与主窗同一套文字色规则：避免系统深色/高对比主题下白字白底看不见 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
  </Window.Styles>

  <!-- 窗口内一层纵向滚动：内容比窗口高时可以滚，横向不滚 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14" Spacing="12">

      <!-- ============ 方案：下拉 + 导入/导出 ============ -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
          <WrapPanel Grid.Row="0" ItemSpacing="8" LineSpacing="6">
            <TextBlock Text="键位方案" Classes="sectionLabel" VerticalAlignment="Center"/>
            <ComboBox x:Name="KeymapCombo" Width="200" FontSize="{DynamicResource FontSmall}"
                      VerticalAlignment="Center" SelectionChanged="KeymapCombo_Changed"
                      ToolTip.Tip="内置方案与自定义方案。选内置方案后还可以在下面继续改"/>
            <Button x:Name="BtnKeymapImport" Content="导入方案…" FontSize="{DynamicResource FontCaption}"
                    Padding="10,3" Classes="secondary" VerticalAlignment="Center"
                    Click="KeymapImport_Click" ToolTip.Tip="读入一个方案 JSON 文件"/>
            <Button x:Name="BtnKeymapExport" Content="导出方案…" FontSize="{DynamicResource FontCaption}"
                    Padding="10,3" Classes="secondary" VerticalAlignment="Center"
                    Click="KeymapExport_Click" ToolTip.Tip="把当前方案写成 JSON 文件"/>
          </WrapPanel>
          <TextBlock Grid.Row="1" x:Name="TxtKeymapHint" Classes="caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrushInfoText}" Text=""/>
        </Grid>
      </Border>

      <!-- ============ 键位：主键列表 + 三个功能键 + 音域与策略 ============ -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

          <TextBlock Grid.Row="0" Grid.Column="0" Text="主键（点键帽，再按一个键即可改）"
                     Classes="sectionLabel" TextWrapping="Wrap"/>

          <!-- 主键列表：按内容自然展开（只给一个很高的上限兜底，不裁切）。
               默认方案 8 条在这个宽度下一行 4 条、两行全露；绑定再多也只会把窗口内容顶高，
               由窗口自己的纵向滚动条承接，绝不会出现「有绑定但看不见」。
               外面的滚动条仍然保留：万一窗口被拉得很窄，列表仍可滚。 -->
          <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4">
            <ScrollViewer Grid.Row="0" x:Name="KeyListScroll" MinHeight="60" MaxHeight="240"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="KeyList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="3" LineSpacing="4"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Content="{Binding Key}" FontSize="{DynamicResource FontMicro}"
                              Padding="0" Classes="secondary" Width="30"
                              HorizontalContentAlignment="Center" Click="KeyBind_Click"
                              ToolTip.Tip="点一下，再按一个新键，就把这个音改到新键"/>
                      <TextBox Text="{Binding Offset}" Width="30"
                               FontSize="{DynamicResource FontMicro}" Padding="2,2"
                               VerticalContentAlignment="Center"
                               ToolTip.Tip="相对基准音的半音偏移"/>
                      <Button Content="✕" FontSize="{DynamicResource FontMicro}"
                              Padding="0" Classes="secondary" Width="20"
                              HorizontalContentAlignment="Center" Click="KeyRemove_Click"
                              ToolTip.Tip="删除这一键"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="1" x:Name="BtnKeyAdd" Content="+ 加一键" FontSize="{DynamicResource FontCaption}"
                    Padding="8,3" Classes="secondary" HorizontalAlignment="Left" Click="KeyAdd_Click"
                    ToolTip.Tip="追加一个按键"/>
          </Grid>

          <!-- 三个功能键 + 基准音 + 音域 + 两条策略 -->
          <WrapPanel Grid.Row="2" Grid.Column="0" ItemSpacing="10" LineSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="八度上" Classes="label"/>
              <Button x:Name="BtnOctaveUp" Content="—" FontSize="{DynamicResource FontCaption}"
                      Padding="8,2" Classes="secondary" MinWidth="72" MaxWidth="104"
                      Click="KeyBindModifier_Click" Tag="up"
                      ToolTip.Tip="点一下，再按一个键，作为升八度键"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="八度下" Classes="label"/>
              <Button x:Name="BtnOctaveDown" Content="—" FontSize="{DynamicResource FontCaption}"
                      Padding="8,2" Classes="secondary" MinWidth="72" MaxWidth="104"
                      Click="KeyBindModifier_Click" Tag="down"
                      ToolTip.Tip="点一下，再按一个键，作为降八度键"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="升半音" Classes="label"/>
              <Button x:Name="BtnSharpKey" Content="—" FontSize="{DynamicResource FontCaption}"
                      Padding="8,2" Classes="secondary" MinWidth="72" MaxWidth="104"
                      Click="KeyBindModifier_Click" Tag="sharp"
                      ToolTip.Tip="点一下，再按一个键，作为升半音键"/>
            </StackPanel>
          </WrapPanel>

          <WrapPanel Grid.Row="3" Grid.Column="0" ItemSpacing="10" LineSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="基准音" Classes="label" ToolTip.Tip="键位偏移的原点。60 = C4"/>
              <TextBox x:Name="TxtBaseNote" Width="46" FontSize="{DynamicResource FontCaption}"
                       Padding="4,2" VerticalContentAlignment="Center"
                       KeyDown="KeymapNumber_KeyDown" LostFocus="KeymapNumber_LostFocus"/>
              <TextBlock x:Name="TxtBaseNoteName" Classes="value" Width="32"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="音域" Classes="label"/>
              <TextBox x:Name="TxtMinNote" Width="46" FontSize="{DynamicResource FontCaption}"
                       Padding="4,2" VerticalContentAlignment="Center"
                       KeyDown="KeymapNumber_KeyDown" LostFocus="KeymapNumber_LostFocus"/>
              <TextBlock Text="~" Classes="value" Width="10" TextAlignment="Center"/>
              <TextBox x:Name="TxtMaxNote" Width="46" FontSize="{DynamicResource FontCaption}"
                       Padding="4,2" VerticalContentAlignment="Center"
                       KeyDown="KeymapNumber_KeyDown" LostFocus="KeymapNumber_LostFocus"/>
              <TextBlock x:Name="TxtMinNoteName" Classes="value" Width="30"/>
              <TextBlock x:Name="TxtMaxNoteName" Classes="value" Width="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="超界策略" Classes="label"/>
              <ComboBox x:Name="OutOfRangeCombo" Width="132" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="KeymapPolicy_Changed"
                        ToolTip.Tip="丢音 = 超出音域的音不发声；折八度 = 把音折回最近的可演奏八度"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="缺音策略" Classes="label"/>
              <ComboBox x:Name="MissingNoteCombo" Width="132" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="KeymapPolicy_Changed"
                        ToolTip.Tip="就近吸附 = 缺的音用最近的可演奏音代替；丢弃 = 直接不发声"/>
            </StackPanel>
          </WrapPanel>

          <!-- 竖向键位预览图 + 图例。放右列：与卷帘左侧琴键栏同一朝向 -->
          <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Margin="12,0,0,0" Padding="8,6"
                  CornerRadius="6" Background="{DynamicResource BrushSurfaceAlt}"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <StackPanel Spacing="5">
              <TextBlock Text="键位预览（音高纵轴）" Classes="sectionLabel" FontWeight="SemiBold"/>
              <local:KeymapKeyboardPreview x:Name="KeymapPreview" Width="176" Height="360"/>
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="#5B6CF0"/>
                  <TextBlock Text="有按键" Classes="caption"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="#B25A00"/>
                  <TextBlock Text="折八度" Classes="caption"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="#A9B3C0"/>
                  <TextBlock Text="丢音" Classes="caption"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="#C0392B"/>
                  <TextBlock Text="音域内缺键" Classes="caption"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="#3A4757"/>
                  <TextBlock Text="无键" Classes="caption"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ============ 说明 ============ -->
      <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="10,8">
        <StackPanel Spacing="4">
          <TextBlock x:Name="TxtPreviewMods" Classes="caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrushTextSecondary}" Text=""/>
          <TextBlock Classes="caption" TextWrapping="Wrap" LineHeight="17"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     Text="改完立即生效并写入方案文件。点键帽或三个功能键按钮后，按一个键完成绑定，按 Esc 取消。"/>
        </StackPanel>
      </Border>

      <Button x:Name="BtnClose" Content="关闭" Classes="accent" HorizontalAlignment="Right"
              Padding="18,6" FontSize="{DynamicResource FontBody}" Click="Close_Click"/>
    </StackPanel>
  </ScrollViewer>
</Window>

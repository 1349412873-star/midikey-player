<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiKeyPlayer.KeymapWindow"
        Title="键位设置"
        Width="900" Height="680"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}"
        PointerPressed="Window_PointerPressed"
        Closed="Window_Closed">

  <Window.Styles>
    <!-- 与主窗同一套文字色规则：避免系统深色 / 高对比主题下白字白底看不见 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>
    <Style Selector="Window TextBlock.link">
      <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 键帽方块里三块「看不见的按钮」：平时不画底色，只有悬停时给一点提示 -->
    <Style Selector="Button.capZone /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.capZone:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.capZone:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.capClose /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.capClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
    </Style>
    <Style Selector="Button.capClose:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>

    <!-- 行尾与行尾下方的「+」：虚线画在 Border/Rectangle 上，按钮本体透明 -->
    <Style Selector="Button.rowPlus">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.rowPlus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.rowPlus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
  </Window.Styles>

  <!-- 下半部分：滚动内容 + 常驻统计行 -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" x:Name="MainScroll"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,12,14,8" Spacing="8">

        <!-- ============ 1. 方案行 ============ -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="方案" Classes="label" VerticalAlignment="Center"/>
              <ComboBox x:Name="KeymapCombo" Width="175" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="KeymapCombo_Changed"
                        ToolTip.Tip="当前正在用的键位方案。改完自动存"/>
              <Button x:Name="BtnNewScheme" Content="新建方案…" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" VerticalAlignment="Center"
                      Click="SchemeNew_Click"
                      ToolTip.Tip="以当前方案为底复制一份新方案，马上可以改名字"/>
              <Button x:Name="BtnRenameScheme" Content="改名…" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" VerticalAlignment="Center"
                      Click="SchemeRename_Click"
                      ToolTip.Tip="给这套方案换个名字"/>
              <Button Content="导入方案…" Classes="secondary" FontSize="{DynamicResource FontCaption}"
                      Padding="8,1" VerticalAlignment="Center" Click="KeymapImport_Click"
                      ToolTip.Tip="读入一个方案 JSON 文件"/>
              <Button Content="导出方案…" Classes="secondary" FontSize="{DynamicResource FontCaption}"
                      Padding="8,1" VerticalAlignment="Center" Click="KeymapExport_Click"
                      ToolTip.Tip="把当前方案写成 JSON 文件"/>
              <Button x:Name="BtnSchemeMenu" Content="管理 ▾" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" MinWidth="28"
                      VerticalAlignment="Center" ToolTip.Tip="删除方案、恢复默认设置">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem x:Name="MiSchemeDelete" Header="删除方案…" Click="SchemeDelete_Click"
                              ToolTip.Tip="删掉这套方案，内置方案不能删"/>
                    <Separator/>
                    <MenuItem x:Name="MiSchemeRestore" Header="恢复默认设置…" Click="SchemeRestore_Click"
                              ToolTip.Tip="把当前方案的键位改回初始键位。不影响你的其他方案"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <TextBlock x:Name="TxtSchemeHint" Classes="caption" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushInfoText}" Text=""/>
          </StackPanel>
        </Border>

        <!-- ============ 2. 按键绑定：一行一行排，行内不换行 ============ -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="按键绑定" Classes="sectionLabel" FontWeight="SemiBold"/>

            <!-- 一条绑都没有时的灰字说明。加行按钮只留下面那一个（曾经这里还有一个「+ 新建第一行」，与它重复） -->
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowEmptyHint}"
                       Text="还没有绑任何键。点下面的「+ 加一行」开始：一行从左到右是 do re mi fa sol la si，键名会自动填好。"/>

            <ItemsControl x:Name="BindRows" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Classes="caption"/>
                    <!-- 一行键帽：横向滚动，绝不换行 -->
                    <Grid ColumnDefinitions="*,Auto">
                      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Width="76" Height="58" Margin="0,0,6,0">
                                <!-- 一个已绑定的音 = 一个键帽方块 -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{Binding BlockBorderBrush}"
                                        BorderThickness="{Binding BlockBorderThickness}"
                                        CornerRadius="8" BoxShadow="0 1 2 0 #140F1729">
                                  <Grid>
                                    <!-- 上半：音名区。点一下开音高下拉 -->
                                    <Button Classes="capZone" Click="BlockPitch_Click" VerticalAlignment="Top"
                                            Height="26" HorizontalContentAlignment="Left" Padding="6,2,16,0"
                                            ToolTip.Tip="点上半块改这个键弹的音高">
                                      <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding PitchName}" FontSize="{DynamicResource FontSmall}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                        <TextBlock Text="{Binding PitchDegree}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                      </StackPanel>
                                    </Button>
                                    <!-- 下半：按键区。点一下再按一个键就改键。
                                         键名另外画一个居中偏下的 TextBlock：TextBlock 不接管点击，点下去还是按钮。 -->
                                    <Button Classes="capZone" Click="BlockKey_Click" VerticalAlignment="Bottom"
                                            Height="30" ToolTip.Tip="点下半块，再按一个键，就把这个键绑到这个音"/>
                                    <TextBlock Text="{Binding KeyCapText}" Foreground="{Binding KeyCapForeground}"
                                               FontSize="{DynamicResource FontSmall}" IsHitTestVisible="False"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Margin="0,0,0,6"/>
                                    <!-- 右上角：解绑 -->
                                    <Button Classes="capClose" Content="✕" Click="RowRemove_Click"
                                            Width="16" Height="16" Padding="0" FontSize="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="解绑这个音"/>
                                  </Grid>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <!-- 行尾「+」：在这一行末尾加一个音（列） -->
                      <Grid Grid.Column="1" Width="34" Height="58" Margin="2,0,0,0">
                        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BrushBorderStrong}"
                                   StrokeThickness="1" StrokeDashArray="3,3"/>
                        <Button Classes="rowPlus" Content="+" FontSize="{DynamicResource FontTitle}"
                                Click="RowAddCell_Click"
                                ToolTip.Tip="在这一行末尾加一个音（列）"/>
                      </Grid>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 最后一行下面的「+」：新增一行，音高比上一行高一个八度 -->
            <StackPanel x:Name="AddRowPanel" Orientation="Horizontal" Spacing="8">
              <Grid Width="110" Height="32">
                <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BrushBorderStrong}"
                           StrokeThickness="1" StrokeDashArray="3,3"/>
                <Button Classes="rowPlus" Content="+ 加一行" FontSize="{DynamicResource FontCaption}"
                        Click="RowAddRow_Click"
                        ToolTip.Tip="在最下面新增一行，音高比上一行高一个八度"/>
              </Grid>
              <TextBlock Classes="caption" VerticalAlignment="Center"
                         Text="行尾的「+」加一个音，这里的「+」加一整行（高一个八度）。行太长时左右滚动看。"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============ 3. 功能键（带启用开关） ============ -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="功能键（让手上的键弹出多个音）"
                         Classes="sectionLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" x:Name="ChkModifiers" Content="启用功能键"
                        FontSize="{DynamicResource FontSmall}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" IsChecked="True" Click="Modifiers_Changed"
                        ToolTip.Tip="不勾时：下面三个键都不生效，超出键位范围的音直接不发声，不做八度折叠"/>
            </Grid>
            <StackPanel x:Name="FuncPanel" Spacing="4">
              <ItemsControl x:Name="FuncRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Width="78" Text="{Binding Label}"
                                 Classes="label" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" CornerRadius="{DynamicResource RadiusControl}"
                              BorderThickness="{Binding WaitBorderThickness}"
                              BorderBrush="{Binding WaitBorderBrush}">
                        <Button Width="130" FontSize="{DynamicResource FontSmall}" Padding="4,2"
                                HorizontalContentAlignment="Center" Classes="secondary"
                                Content="{Binding KeyCapText}"
                                Foreground="{Binding KeyCapForeground}"
                                Click="FuncKey_Click"
                                ToolTip.Tip="点一下，再按一个键，就把这个功能绑到这个键。Shift、Ctrl、Alt 单独按一下再松开也行"/>
                      </Border>
                      <ComboBox Grid.Column="2" Width="130" Margin="6,0,0,0"
                                FontSize="{DynamicResource FontCaption}"
                                VerticalAlignment="Center" IsVisible="{Binding Waiting}"
                                ItemsSource="{Binding KeyChoices}"
                                SelectionChanged="KeyName_Changed"
                                PlaceholderText="选键名"
                                ToolTip.Tip="手选一个键名，效果等于按了那个键"/>
                      <Button Grid.Column="3" Content="✕" Width="24" Margin="6,0,0,0"
                              Padding="0" FontSize="{DynamicResource FontMicro}"
                              HorizontalContentAlignment="Center" Classes="secondary"
                              Click="FuncClear_Click" ToolTip.Tip="不用这个功能键，点了以后显示「未设置」"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 常驻统计行 -->
    <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatsText}" Classes="caption" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>

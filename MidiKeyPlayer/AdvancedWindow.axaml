<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiKeyPlayer.AdvancedWindow"
        Title="高级设置"
        Width="640" Height="470"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}"
        Closed="Window_Closed">

  <Window.Styles>
    <!-- 与主窗、键位窗同一套文字色规则：避免系统深色 / 高对比主题下白字白底看不见。
         内容控件是从主窗搬进来的（见 MainWindow 的 Advanced_Click），
         所以这里必须自带这套规则，否则搬过来以后文字色会跟着新窗口的默认值走。 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <!-- 顶部：标题 + 一句话说明。说明写明这些项为什么搬到这里。 -->
    <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,12">
      <TextBlock Text="高级设置" FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold"/>
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="设备接入、输入兼容、热键、导出按键表与播放前自检。这些项不常改，从主界面搬到这里。"/>
    </StackPanel>

    <!-- 底部：关闭。改动即时生效，没有「应用」按钮。 -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock Classes="caption" VerticalAlignment="Center"
                 Text="改动即时生效，关掉本窗口不影响设置。"/>
      <Button Content="关闭" Classes="secondary" Padding="18,6" Click="Close_Click"/>
    </StackPanel>

    <!-- 内容：整块从主窗搬进来（AdvancedWindow.Attach） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="Host"/>
    </ScrollViewer>
  </DockPanel>
</Window>
